
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the TradeStream application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity."
        },
        "username": {
          "type": "string",
          "description": "The user's chosen username."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        },
        "fullName": {
          "type": "string",
          "description": "The user's full name."
        },
        "createdAt": {
          "type": "string",
          "description": "The timestamp when the user account was created.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "username",
        "email",
        "fullName",
        "createdAt"
      ]
    },
    "Trade": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Trade",
      "type": "object",
      "description": "Represents a single stock options trade.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Trade entity."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User. The user who made the trade."
        },
        "ticker": {
          "type": "string",
          "description": "The stock ticker symbol."
        },
        "optionType": {
          "type": "string",
          "description": "The type of option (call, put)."
        },
        "expirationDate": {
          "type": "string",
          "description": "The expiration date of the option.",
          "format": "date-time"
        },
        "strikePrice": {
          "type": "number",
          "description": "The strike price of the option."
        },
        "tradeSize": {
          "type": "number",
          "description": "The size of the trade."
        },
        "tradePrice": {
          "type": "number",
          "description": "The price at which the trade was executed."
        },
        "timestamp": {
          "type": "string",
          "description": "The timestamp when the trade was executed.",
          "format": "date-time"
        },
        "groupId": {
          "type": "string",
          "description": "Optional reference to a Group if the trade is exclusive to a group."
        }
      },
      "required": [
        "id",
        "userId",
        "ticker",
        "optionType",
        "expirationDate",
        "strikePrice",
        "tradeSize",
        "tradePrice",
        "timestamp"
      ]
    },
    "Group": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Group",
      "type": "object",
      "description": "Represents a subscription-based group created by a trader.",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "creatorId": {
          "type": "string",
          "description": "The user ID of the creator."
        },
        "monthlyPrice": {
          "type": "number"
        },
        "avatar": {
          "type": "string"
        },
        "memberCount": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "name",
        "creatorId",
        "monthlyPrice"
      ]
    },
    "Membership": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Membership",
      "type": "object",
      "description": "Represents a user's active subscription to a group.",
      "properties": {
        "id": {
          "type": "string"
        },
        "groupId": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "groupId",
        "userId",
        "expiresAt"
      ]
    },
    "Follow": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Follow",
      "type": "object",
      "description": "Represents the following relationship between users.",
      "properties": {
        "id": { "type": "string" },
        "followerId": { "type": "string" },
        "followingId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "followerId", "followingId", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "User profiles."
        }
      },
      {
        "path": "/users/{userId}/trades/{tradeId}",
        "definition": {
          "entityName": "Trade",
          "schema": { "$ref": "#/backend/entities/Trade" },
          "description": "Personal trades for a user."
        }
      },
      {
        "path": "/groups/{groupId}",
        "definition": {
          "entityName": "Group",
          "schema": { "$ref": "#/backend/entities/Group" },
          "description": "Exclusive trading groups."
        }
      },
      {
        "path": "/groups/{groupId}/memberships/{userId}",
        "definition": {
          "entityName": "Membership",
          "schema": { "$ref": "#/backend/entities/Membership" },
          "description": "Active group subscriptions."
        }
      }
    ]
  }
}
