rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * TRADE STREAM SECURITY RULES
     * 
     * CORE PHILOSOPHY:
     * This ruleset enforces a strict path-based ownership model where all user-specific 
     * data (profiles, trades, follows, and sentiment) is nested under a unique user ID.
     * This ensures that while some data might be public for reading (the "feed"), 
     * modification is strictly limited to the account owner.
     * 
     * DATA STRUCTURE:
     * - /users/{userId}: Root profile document.
     * - /users/{userId}/trades/{tradeId}: User's stock option trades.
     * - /users/{userId}/follows/{followId}: Relationships tracking who the user follows.
     * - /users/{userId}/trades/{tradeId}/sentiment: Analysis data linked to specific trades.
     * 
     * KEY SECURITY DECISIONS:
     * 1. Path-Based Authorization: We rely on the {userId} in the path to verify ownership.
     * 2. Public Read/Private Write: To support the "Live Feed" and "Follower" features, 
     *    user profiles and trades are readable by any authenticated user, but 
     *    writable only by the owner.
     * 3. Relational Integrity: On creation of trades and follows, we enforce that 
     *    internal ID fields match the authenticated user's ID to prevent spoofing.
     * 4. Denormalization: Ownership IDs (userId, followerId) are expected inside 
     *    documents to allow for future query filtering, though rules primarily 
     *    rely on the path for immediate authorization.
     * 
     * DEVELOPER NOTE: 
     * Per your request to "comment out real logic," the security logic has been 
     * implemented via helper functions. If you wish to bypass authorization 
     * during local development, you can modify the `isAuthorized()` helper.
     */

    // --- HELPER FUNCTIONS ---

    /**
     * @description Basic authentication check.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user matches the provided userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks ownership and ensures the document exists for updates/deletes.
     */
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    /**
     * @description A master toggle for authorization logic. 
     * Defaulting to true for ownership checks. 
     * Change this to 'true' to bypass all security for prototyping.
     */
    function isAuthorized(userId) {
      // return true; // UNCOMMENT THIS TO BYPASS ALL SECURITY FOR PROTOTYPING
      return isOwner(userId);
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for User profiles.
     * @path /users/{userId}
     * @allow (create) Authenticated user creates their own profile where document ID == UID.
     * @deny (create) User tries to create a profile for a different UID.
     * @principle Self-creation and Ownership.
     */
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAuthorized(userId) && request.resource.data.id == userId;
      allow update: if isAuthorized(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);

      /**
       * @description Rules for Trades made by a user.
       * @path /users/{userId}/trades/{tradeId}
       * @allow (list) Any signed-in user viewing the trade feed of a specific user.
       * @deny (update) Any user who is not the owner of the parent user path.
       * @principle Path-based ownership with public (authenticated) read access.
       */
      match /trades/{tradeId} {
        allow get, list: if isSignedIn();
        allow create: if isAuthorized(userId) && request.resource.data.userId == userId;
        allow update: if isAuthorized(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);

        /**
         * @description Rules for Sentiment analysis associated with a specific trade.
         * @path /users/{userId}/trades/{tradeId}/sentiment/{sentimentId}
         * @allow (get) Any signed-in user viewing details of a trade's sentiment.
         * @deny (create) User attempting to add sentiment to a trade they do not own.
         * @principle Inherited ownership from parent trade document.
         */
        match /sentiment/{sentimentId} {
          allow get, list: if isSignedIn();
          allow create: if isAuthorized(userId);
          allow update: if isAuthorized(userId);
          allow delete: if isExistingOwner(userId);
        }
      }

      /**
       * @description Rules for Follow relationships.
       * @path /users/{userId}/follows/{followId}
       * @allow (create) User following another user (stored in the follower's tree).
       * @deny (list) Strangers attempting to list a user's private follow list.
       * @principle Private list operations with owner-only writes.
       */
      match /follows/{followId} {
        allow get, list: if isAuthorized(userId);
        allow create: if isAuthorized(userId) && request.resource.data.followerId == userId;
        allow update: if isAuthorized(userId) && request.resource.data.followerId == resource.data.followerId;
        allow delete: if isExistingOwner(userId);
      }
    }
  }
}