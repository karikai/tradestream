
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the TradeStream application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity."
        },
        "username": {
          "type": "string",
          "description": "The user's chosen username."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        },
        "fullName": {
          "type": "string",
          "description": "The user's full name."
        },
        "createdAt": {
          "type": "string",
          "description": "The timestamp when the user account was created.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "username",
        "email",
        "fullName",
        "createdAt"
      ]
    },
    "Trade": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Trade",
      "type": "object",
      "description": "Represents a single stock options trade with detailed performance metrics.",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "ticker": {
          "type": "string"
        },
        "optionType": {
          "type": "string",
          "enum": ["call", "put"]
        },
        "strikePrice": {
          "type": "number"
        },
        "expirationDate": {
          "type": "string",
          "format": "date-time"
        },
        "contractsPurchased": {
          "type": "number"
        },
        "averageCost": {
          "type": "number"
        },
        "contractsSold": {
          "type": "number"
        },
        "priceAtClose": {
          "type": "number"
        },
        "profitAmount": {
          "type": "number"
        },
        "profitPercentage": {
          "type": "number"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "groupId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "userId",
        "ticker",
        "optionType",
        "strikePrice",
        "expirationDate",
        "contractsPurchased",
        "averageCost",
        "timestamp"
      ]
    },
    "Group": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Group",
      "type": "object",
      "description": "Represents a subscription-based group created by a trader.",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "creatorId": {
          "type": "string"
        },
        "monthlyPrice": {
          "type": "number"
        },
        "avatar": {
          "type": "string"
        },
        "memberCount": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "name",
        "creatorId",
        "monthlyPrice"
      ]
    },
    "Membership": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Membership",
      "type": "object",
      "description": "Represents a user's active subscription to a group.",
      "properties": {
        "id": {
          "type": "string"
        },
        "groupId": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "groupId",
        "userId",
        "expiresAt"
      ]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "User profiles."
    },
    "/users/{userId}/trades/{tradeId}": {
      "schema": { "$ref": "#/backend/entities/Trade" },
      "description": "Personal trades for a user."
    },
    "/groups/{groupId}": {
      "schema": { "$ref": "#/backend/entities/Group" },
      "description": "Exclusive trading groups."
    },
    "/groups/{groupId}/memberships/{userId}": {
      "schema": { "$ref": "#/backend/entities/Membership" },
      "description": "Active group subscriptions."
    }
  }
}
